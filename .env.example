NODE_ENV=development
PORT=8000
API_PREFIX=api
API_VERSION=v1
DATABASE_URL="postgresql://admin:admin123@127.0.0.1:5432/tenant_school"
SHADOW_DATABASE_URL="postgresql://admin:admin123@127.0.0.1:5432/tenant_school_shadow"
TEST_DATABASE_URL="postgresql://admin:admin123@127.0.0.1:5432/tenant_school_test"
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:8001,http://localhost:5173
REDIS_URL="redis://localhost:6379"
QUEUES_ENABLED=false
ENABLE_SWAGGER=false
JWT_ACCESS_SECRET=replace-with-a-secure-secret
JWT_REFRESH_SECRET=replace-with-a-secure-secret
JWT_ACCESS_EXPIRES_IN=15h
JWT_REFRESH_EXPIRES_IN=12d
DEFAULT_TIMEZONE=Asia/Kolkata
INVITATION_EXPIRES_IN_HOURS=72
